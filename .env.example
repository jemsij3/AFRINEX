# AFRINEX Environment & Deployment Variables Reference
# Never commit real tokens, API keys, or `.dev.vars` / `.env` files to GitHub.
#
# 1. Local Cloudflare Worker runtime secrets:
#    Copy `.dev.vars.example` to `.dev.vars` (gitignored) for local Wrangler testing.
#
# 2. Production Cloudflare Worker secrets:
#    Set via `npx wrangler secret put <NAME>` after creating the Cloudflare Worker.
#
# 3. GitHub Actions CI/CD deployment secrets (GitHub -> Settings -> Secrets -> Actions):
#    CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
#    CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# Non-secret Worker vars (configured in wrangler.toml [vars] for production):
ENVIRONMENT="development"
APP_BASE_URL="https://your-afrinex-app.example.workers.dev"
WORKERS_AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Worker secrets (set in `.dev.vars` locally or via `wrangler secret put` in Cloudflare):
TELEGRAM_BOT_TOKEN="replace-with-botfather-token"
TELEGRAM_WEBHOOK_SECRET="replace-with-random-32-char-secret"
BOT_TOKEN_ENCRYPTION_KEY="replace-with-64-hex-char-32-byte-aes-gcm-key"
JWT_SECRET="replace-with-random-64-char-hmac-secret"
ADMIN_TELEGRAM_IDS="replace-with-admin-telegram-numeric-id"
